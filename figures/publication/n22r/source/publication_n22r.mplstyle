# N22R final publication figure style. Exact Arial is enforced on Windows CI.
font.family: Arial
font.sans-serif: Arial
font.size: 8
axes.labelsize: 8.2
axes.titlesize: 8.2
xtick.labelsize: 7.3
ytick.labelsize: 7.3
legend.fontsize: 7.0
axes.linewidth: 0.65
axes.grid: False
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 1.2
lines.markersize: 3.7
legend.frameon: False
savefig.bbox: standard
savefig.pad_inches: 0
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
